# Скопируй эти переменные в Render → Settings → Environment
# (Локально можешь создать файл .env для теста, но он не коммитится)

# Ключ Groq (обязателен). Получить бесплатно, без карты: https://console.groq.com/keys
AI_KEY=

# Модель Groq (по умолчанию openai/gpt-oss-20b — подтверждена как доступная).
# Другие проверенные варианты для этого ключа: openai/gpt-oss-120b (умнее, чуть дороже/медленнее),
# qwen/qwen3.6-27b, groq/compound (со встроенным веб-поиском)
# Полный список того, что доступно именно твоему ключу — /api/models на сервере
AI_MODEL=openai/gpt-oss-20b

# URL API (обычно менять не нужно)
AI_URL=https://api.groq.com/openai/v1/chat/completions

# Скопируй эти переменные в Render → Settings → Environment
# (Локально можешь создать файл .env для теста, но он не коммитится)

# Ключ Pollinations (если есть) — без него запросы идут анонимно с лимитом по IP
POLLINATIONS_KEY=

# Модель Pollinations (по умолчанию "openai")
POLLINATIONS_MODEL=openai

# URL Pollinations API (обычно менять не нужно)
POLLINATIONS_URL=https://text.pollinations.ai/openai

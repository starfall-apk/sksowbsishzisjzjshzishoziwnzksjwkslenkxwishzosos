# Скопируй эти переменные в Render → Settings → Environment
# (Локально можешь создать файл .env для теста, но он не коммитится)

# Ключ Groq (обязателен). Получить бесплатно, без карты: https://console.groq.com/keys
AI_KEY=

# Модель Groq (по умолчанию llama-3.1-8b-instant — стабильная и с высокими лимитами).
# Другие варианты: llama-3.3-70b-versatile, gemma2-9b-it, moonshotai/kimi-k2-instruct
# Если модель снова даст 404 — открой /api/models на своём сервисе,
# там будет полный список моделей, реально доступных твоему ключу.
AI_MODEL=llama-3.1-8b-instant

# URL API (обычно менять не нужно)
AI_URL=https://api.groq.com/openai/v1/chat/completions
